<!-- Header -->
<div class="flex items-center justify-between mb-6">
    <p class="text-sm text-surface-400">Manage application deployments</p>
</div>

<!-- Error History -->
<div id="error-history-container" class="mb-4"></div>

<!-- Search -->
<div class="mb-6">
    <input type="text" id="app-search" placeholder="Search apps..." 
        class="w-full px-4 py-2 bg-surface-800 border border-white/10 rounded-lg text-sm text-white placeholder-surface-500 focus:outline-none focus:border-accent-500"
        oninput="AppManager.search(this.value)">
</div>

<!-- App Grid -->
<div id="apps-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <div class="bg-surface-900/60 border border-white/5 rounded-xl p-8 text-center col-span-full">
        <span class="text-surface-500">Loading applications...</span>
    </div>
</div>

<script>
var AppMetrics = {};
var AppSystemMetrics = {};
var AppsByDomainData = {};
var CpuHistory = {};
var CPU_REFRESH_INTERVAL = 2000;
var CPU_HISTORY_SECONDS = 30;
var CPU_HISTORY_MAX_POINTS = (CPU_HISTORY_SECONDS * 1000) / CPU_REFRESH_INTERVAL;
var ErrorHistory = [];
var MAX_ERROR_HISTORY = 20;

function addError(source, message) {
    ErrorHistory.unshift({
        time: new Date().toLocaleTimeString(),
        source: source,
        message: message
    });
    if (ErrorHistory.length > MAX_ERROR_HISTORY) {
        ErrorHistory.pop();
    }
    renderErrorHistory();
}

function renderErrorHistory() {
    var container = document.getElementById('error-history-container');
    if (!container) return;
    if (ErrorHistory.length === 0) {
        container.innerHTML = '';
        return;
    }
    // e.message is the API error body, which may echo tenant-controlled strings.
    container.innerHTML = ErrorHistory.map(function(e) {
        return '<div class="text-xs text-rose-400 py-1"><span class="text-surface-500">[' + AdminAPI.esc(e.time) + ']</span> <span class="text-surface-400">' + AdminAPI.esc(e.source) + ':</span> ' + AdminAPI.esc(e.message) + '</div>';
    }).join('');
}

var AppSseConnection = null;

function connectAppEvents() {
    if (AppSseConnection) {
        AppSseConnection.close();
    }
    
    AppSseConnection = new EventSource('/api/v1/events/apps');
    
    AppSseConnection.onmessage = function(e) {
        try {
            var event = JSON.parse(e.data);
            handleAppEvent(event);
        } catch (err) {
            console.error('Failed to parse SSE event:', err);
        }
    };
    
    AppSseConnection.onerror = function(err) {
        console.error('SSE error:', err);
        addError('SSE', 'Connection lost, reconnecting...');
        setTimeout(connectAppEvents, 5000);
    };
    
    AppSseConnection.onopen = function() {
        console.log('SSE connected');
    };
}

function handleAppEvent(event) {
    if (event.type === 'StatusChanged' || event.type === 'Deployed' || event.type === 'Stopped') {
        refreshAppStatus(event.app_name);
    }
}

function refreshAppStatus(appName) {
    Promise.all([
        AdminAPI.getAppsByDomain(),
        AdminAPI.getAllAppSystemMetrics()
    ]).then(function(results) {
        AppsByDomainData = results[0].data;
        AppSystemMetrics = results[1].data || {};
        
        Object.keys(AppSystemMetrics).forEach(function(name) {
            var sysMetrics = AppSystemMetrics[name];
            updateCpuHistory(name, {
                blue: (sysMetrics.blue && sysMetrics.blue.cpu_percent) || 0,
                green: (sysMetrics.green && sysMetrics.green.cpu_percent) || 0
            });
        });
        
        AppManager.render(AppsByDomainData, false);
    }).catch(function(err) {
        addError('refreshAppStatus', err.message);
    });
}

var AppManager = {
    STORAGE_KEY: 'admin-apps-expanded-domains',

    getExpandedDomains: function() {
        try {
            var stored = localStorage.getItem(this.STORAGE_KEY);
            return stored ? JSON.parse(stored) : {};
        } catch (e) {
            return {};
        }
    },

    saveExpandedDomain: function(domainId, expanded) {
        var expandedMap = this.getExpandedDomains();
        expandedMap[domainId] = expanded;
        try {
            localStorage.setItem(this.STORAGE_KEY, JSON.stringify(expandedMap));
        } catch (e) {}
    },

    load: function() {
        return Promise.all([
            AdminAPI.getAppsByDomain(),
            AdminAPI.getAllAppMetrics(),
            AdminAPI.getAllAppSystemMetrics()
        ]).then(function(results) {
            AppsByDomainData = results[0].data;
            AppMetrics = results[1].data || {};
            AppSystemMetrics = results[2].data || {};
            
            Object.keys(AppSystemMetrics).forEach(function(name) {
                var sysMetrics = AppSystemMetrics[name];
                updateCpuHistory(name, {
                    blue: (sysMetrics.blue && sysMetrics.blue.cpu_percent) || 0,
                    green: (sysMetrics.green && sysMetrics.green.cpu_percent) || 0
                });
            });
            
            AppManager.render(AppsByDomainData, false);
        }).catch(function(err) {
            addError('AppManager.load', err.message);
            AdminAPI.toast('Failed to load applications: ' + err.message, 'error');
            document.getElementById('apps-grid').innerHTML =
                '<div class="bg-surface-900/60 border border-white/5 rounded-xl p-8 text-center col-span-full">' +
                '<span class="text-rose-400">Failed to load applications</span></div>';
        });
    },

    render: function(appsByDomain, isSearch) {
        isSearch = isSearch || false;
        var grid = document.getElementById('apps-grid');
        var expandedDomains = AppManager.getExpandedDomains();
        
        if (!appsByDomain || Object.keys(appsByDomain).length === 0) {
            grid.innerHTML = '<div class="bg-surface-900/60 border border-white/5 rounded-xl p-8 text-center col-span-full">' +
                '<div class="text-surface-500 mb-2">No applications</div>' +
                '<div class="text-xs text-surface-600">Applications are discovered from the sites/ directory</div></div>';
            return;
        }

        var domains = Object.keys(appsByDomain).sort();
        
        grid.innerHTML = domains.map(function(domain) {
            var apps = appsByDomain[domain];
            var domainId = 'domain-' + domain.replace(/[^a-zA-Z0-9]/g, '-');
            var isExpanded = isSearch || expandedDomains[domainId] ? '' : 'hidden';
            var chevronHtml = isSearch || expandedDomains[domainId]
                ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>'
                : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>';
            
            var appsHtml = apps.map(function(app) {
                return AppManager.renderApp(app);
            }).join('');

            return '<div class="domain-group col-span-full border border-white/5 rounded-xl overflow-hidden mb-4">' +
                '<button class="domain-header w-full px-5 py-4 bg-surface-800/50 flex items-center justify-between hover:bg-surface-800/70 transition-colors" data-domain-id="' + AdminAPI.esc(domainId) + '">' +
                    '<div class="flex items-center gap-3">' +
                        '<svg class="domain-chevron w-4 h-4 text-surface-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">' + chevronHtml + '</svg>' +
                        '<span class="text-sm font-medium text-white">' + AdminAPI.esc(domain) + '</span>' +
                        '<span class="text-xs text-surface-500 bg-surface-700 px-2 py-0.5 rounded-full">' + apps.length + '</span>' +
                    '</div>' +
                '</button>' +
                '<div id="' + AdminAPI.esc(domainId) + '" class="domain-content grid grid-cols-1 lg:grid-cols-2 gap-4 p-4 ' + isExpanded + '">' +
                    appsHtml +
                '</div>' +
            '</div>';
        }).join('');
    },

    search: function(query) {
        query = query.toLowerCase().trim();
        if (!query) {
            AppManager.render(AppsByDomainData, false);
            return;
        }
        var filtered = {};
        for (var domain in AppsByDomainData) {
            var apps = AppsByDomainData[domain].filter(function(app) {
                var name = (app.config && app.config.name) || '';
                var domain = (app.config && app.config.domain) || '';
                return name.toLowerCase().includes(query) || domain.toLowerCase().includes(query);
            });
            if (apps.length > 0) {
                filtered[domain] = apps;
            }
        }
        AppManager.render(filtered, true);
    },

    // Single delegated click handler for everything rendered into #apps-grid.
    // App names come from the API, so they are only ever carried in data-*
    // attributes and read back via dataset — never interpolated into inline JS.
    bindGridEvents: function() {
        var grid = document.getElementById('apps-grid');
        if (!grid || grid._eventsBound) return;
        grid._eventsBound = true;
        grid.addEventListener('click', function(ev) {
            var header = ev.target.closest('[data-domain-id]');
            if (header && grid.contains(header)) {
                AppManager.toggleDomain(header.dataset.domainId, header);
                return;
            }
            var btn = ev.target.closest('[data-app][data-action]');
            if (!btn || !grid.contains(btn)) return;
            var name = btn.dataset.app;
            var action = btn.dataset.action;
            if (action === 'logs') {
                AppManager.showLogs(name);
            } else if (action === 'deploy' || action === 'restart' || action === 'stop') {
                AppManager.action(name, action, btn);
            }
        });
    },

    toggleDomain: function(domainId, btn) {
        var content = document.getElementById(domainId);
        var chevron = btn.querySelector('.domain-chevron');
        if (content.classList.contains('hidden')) {
            content.classList.remove('hidden');
            chevron.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>';
            AppManager.saveExpandedDomain(domainId, true);
        } else {
            content.classList.add('hidden');
            chevron.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>';
            AppManager.saveExpandedDomain(domainId, false);
        }
    },

    renderApp: function(app) {
        var cfg = app.config || {};
        var name = cfg.name || cfg.domain || 'unknown';
        var currentSlot = app.current_slot || '-';
        var blueStatus = app.blue ? (app.blue.status || 'stopped') : 'stopped';
        var greenStatus = app.green ? (app.green.status || 'stopped') : 'stopped';
        var bluePort = app.blue && app.blue.port ? app.blue.port : 0;
        var greenPort = app.green && app.green.port ? app.green.port : 0;
        var domain = cfg.domain || '';

        var metrics = AppMetrics[name] || {};
        var reqs = metrics.requests || 0;
        var errors = metrics.errors || 0;
        var avgTime = metrics.avg_response_time_ms || 0;

        var sysMetrics = AppSystemMetrics[name] || { blue: {}, green: {} };
        var blueMem = sysMetrics.blue && sysMetrics.blue.memory_rss_bytes;
        var greenMem = sysMetrics.green && sysMetrics.green.memory_rss_bytes;
        var blueCpu = sysMetrics.blue && sysMetrics.blue.cpu_percent;
        var greenCpu = sysMetrics.green && sysMetrics.green.cpu_percent;

        function formatBytes(b) {
            if (!b) return '-';
            if (b >= 1073741824) return (b / 1073741824).toFixed(1) + 'G';
            if (b >= 1048576) return (b / 1048576).toFixed(1) + 'M';
            if (b >= 1024) return (b / 1024).toFixed(0) + 'K';
            return b + 'B';
        }

        var testDomain = '';
        if (domain && !domain.endsWith('.test') && !domain.endsWith('.localhost')) {
            var lastDot = domain.lastIndexOf('.');
            if (lastDot > 0) {
                testDomain = domain.substring(0, lastDot) + '.test';
            }
        }
        var hasTestDomain = testDomain !== '';

        var errorRate = reqs > 0 ? ((errors / reqs) * 100).toFixed(1) : 0;

        var anyRunning = blueStatus.toLowerCase() === 'running' || greenStatus.toLowerCase() === 'running';
        var anyStarting = blueStatus.toLowerCase() === 'starting' || greenStatus.toLowerCase() === 'starting';
        var healthLabel, healthColor, healthBg, healthBorder, healthDot;
        if (anyRunning && errorRate < 5) {
            healthLabel = 'Healthy'; healthColor = 'text-accent-400'; healthBg = 'bg-accent-500/10'; healthBorder = 'border-accent-500/20'; healthDot = 'bg-accent-400';
        } else if (anyStarting) {
            healthLabel = 'Starting'; healthColor = 'text-accent-400'; healthBg = 'bg-accent-500/10'; healthBorder = 'border-accent-500/20'; healthDot = 'bg-accent-400';
        } else if (anyRunning && errorRate >= 5) {
            healthLabel = 'Degraded'; healthColor = 'text-amber-400'; healthBg = 'bg-amber-500/10'; healthBorder = 'border-amber-500/20'; healthDot = 'bg-amber-400';
        } else {
            healthLabel = 'Stopped'; healthColor = 'text-surface-500'; healthBg = 'bg-surface-500/10'; healthBorder = 'border-surface-500/20'; healthDot = 'bg-surface-500';
        }

        function statusDot(status) {
            var s = status.toLowerCase();
            if (s === 'running') return 'bg-accent-400';
            if (s === 'starting') return 'bg-accent-400';
            if (s === 'stopped') return 'bg-surface-600';
            return 'bg-amber-400';
        }

        function statusText(status) {
            var s = status.toLowerCase();
            if (s === 'running') return 'text-accent-400';
            if (s === 'starting') return 'text-accent-400';
            if (s === 'stopped') return 'text-surface-500';
            return 'text-amber-400';
        }

        function formatNum(n) {
            if (n >= 1000000) return (n/1000000).toFixed(1) + 'M';
            if (n >= 1000) return (n/1000).toFixed(1) + 'k';
            return n.toString();
        }

        return '<div class="bg-surface-900/60 border border-white/5 rounded-xl overflow-hidden">' +
            '<div class="px-5 pt-6 pb-4">' +
                '<div class="flex items-center justify-between mb-3">' +
                    '<div class="min-w-0">' +
                        '<h3 class="text-sm font-semibold text-white truncate">' + AdminAPI.esc(name) + '</h3>' +
                        '<div class="flex items-center gap-2 mt-0.5 text-xs">' +
                            (domain ? '<span class="text-surface-500 font-mono truncate">' + AdminAPI.esc(domain) + '</span>' : '') +
                            (hasTestDomain ? '<a href="http://' + AdminAPI.esc(testDomain) + '" target="_blank" class="shrink-0 text-accent-400 hover:text-accent-300 transition-colors">dev</a>' : '') +
                        '</div>' +
                    '</div>' +
                    '<span class="shrink-0 flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium border ' + healthBg + ' ' + healthColor + ' ' + healthBorder + '">' +
                        '<span class="w-1.5 h-1.5 rounded-full ' + healthDot + '"></span>' +
                        healthLabel +
                    '</span>' +
                '</div>' +
                '<div class="flex items-center gap-3 bg-surface-800/30 rounded-lg px-3 py-2">' +
                    '<div class="text-xs font-medium ' + (currentSlot === 'blue' ? 'text-accent-400' : 'text-accent-400') + '" data-cpu-current-value data-app-name="' + AdminAPI.esc(name) + '" data-slot="' + AdminAPI.esc(currentSlot) + '">-</div>' +
                    '<div data-cpu-graph-current data-app-name="' + AdminAPI.esc(name) + '" data-current-slot="' + AdminAPI.esc(currentSlot) + '" class="flex-1 h-8">' + renderCpuGraph(name, currentSlot) + '</div>' +
                    '<div class="text-xs text-surface-400">' + (currentSlot === 'blue' ? (blueMem ? formatBytes(blueMem) : '-') : (greenMem ? formatBytes(greenMem) : '-')) + '</div>' +
                '</div>' +
            '</div>' +
            '<div class="px-5 pb-4">' +
                '<div class="flex gap-3">' +
                    '<div class="flex-1 bg-surface-800/50 rounded-lg p-3 text-center">' +
                        '<div class="text-lg font-bold text-white">' + formatNum(reqs) + '</div>' +
                        '<div class="text-xs text-surface-500">Requests</div>' +
                    '</div>' +
                    '<div class="flex-1 bg-surface-800/50 rounded-lg p-3 text-center">' +
                        '<div class="text-lg font-bold ' + (avgTime < 100 ? 'text-accent-400' : avgTime < 500 ? 'text-amber-400' : 'text-rose-400') + '">' + (avgTime > 0 && avgTime < 1 ? Math.round(avgTime * 1000) + '<span class="text-xs font-normal text-surface-500">µs</span>' : Math.round(avgTime) + '<span class="text-xs font-normal text-surface-500">ms</span>') + '</div>' +
                        '<div class="text-xs text-surface-500">Avg Time</div>' +
                    '</div>' +
                    '<div class="flex-1 bg-surface-800/50 rounded-lg p-3 text-center">' +
                        '<div class="text-lg font-bold ' + (errors > 0 ? 'text-rose-400' : 'text-surface-500') + '">' + formatNum(errors) + '</div>' +
                        '<div class="text-xs text-surface-500">Errors</div>' +
                    '</div>' +
                '</div>' +
            '</div>' +
            '<div class="px-5 py-4">' +
                '<div class="grid grid-cols-2 gap-3">' +
                    '<div class="flex items-center gap-2 px-3 py-3 rounded-lg ' + (currentSlot === 'blue' ? 'bg-accent-500/5 border border-accent-500/20' : 'bg-surface-800/30') + '">' +
                        '<span class="w-2 h-2 rounded-full ' + statusDot(blueStatus) + '"></span>' +
                        '<div class="min-w-0 flex-1">' +
                            '<div class="text-xs font-medium ' + (currentSlot === 'blue' ? 'text-accent-400' : 'text-surface-400') + '">Blue' + (currentSlot === 'blue' ? ' <span class="text-accent-500/60">active</span>' : '') + '</div>' +
                            '<div class="text-xs ' + statusText(blueStatus) + '">' + AdminAPI.esc(blueStatus) + (bluePort ? ' :' + AdminAPI.esc(bluePort) : '') + '</div>' +
                        '</div>' +
                    '</div>' +
                    '<div class="flex items-center gap-2 px-3 py-3 rounded-lg ' + (currentSlot === 'green' ? 'bg-accent-500/5 border border-accent-500/20' : 'bg-surface-800/30') + '">' +
                        '<span class="w-2 h-2 rounded-full ' + statusDot(greenStatus) + '"></span>' +
                        '<div class="min-w-0 flex-1">' +
                            '<div class="text-xs font-medium ' + (currentSlot === 'green' ? 'text-accent-400' : 'text-surface-400') + '">Green' + (currentSlot === 'green' ? ' <span class="text-accent-500/60">active</span>' : '') + '</div>' +
                            '<div class="text-xs ' + statusText(greenStatus) + '">' + AdminAPI.esc(greenStatus) + (greenPort ? ' :' + AdminAPI.esc(greenPort) : '') + '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>' +
            '<div class="flex items-center border-t border-white/5 divide-x divide-white/5">' +
                // Actions are bound by the delegated click handler on #apps-grid (see bindGridEvents).
                '<button data-app="' + AdminAPI.esc(name) + '" data-action="deploy" data-loading-text="Deploying..." class="flex-1 px-3 py-2.5 text-xs font-medium text-accent-400 hover:bg-accent-500/5 transition-colors">Deploy</button>' +
                '<button data-app="' + AdminAPI.esc(name) + '" data-action="restart" data-loading-text="Restarting..." class="flex-1 px-3 py-2.5 text-xs font-medium text-surface-400 hover:bg-white/5 transition-colors">Restart</button>' +
                '<button data-app="' + AdminAPI.esc(name) + '" data-action="stop" data-loading-text="Stopping..." class="flex-1 px-3 py-2.5 text-xs font-medium text-rose-400 hover:bg-rose-500/5 transition-colors">Stop</button>' +
                '<button data-app="' + AdminAPI.esc(name) + '" data-action="logs" class="flex-1 px-3 py-2.5 text-xs font-medium text-surface-400 hover:bg-white/5 transition-colors">Logs</button>' +
            '</div>' +
        '</div>';
    },

    action: function(name, action, btn) {
        if (btn) AdminAPI.setButtonLoading(btn, true);
        AdminAPI.appAction(name, action).then(function(d) {
            AdminAPI.toast(d.data.message || (action + ' started'), 'success');
            setTimeout(function() { AppManager.load(); }, 1500);
        }).catch(function(err) {
            addError('AppManager.action(' + action + ')', err.message);
            AdminAPI.toast('Failed: ' + err.message, 'error');
            if (btn) AdminAPI.setButtonLoading(btn, false);
        });
    },

    showLogs: function(name) {
        AdminAPI.getAppLogs(name).then(function(d) {
            var logs = d.data;
            var html = '<div class="p-6">' +
                '<h2 class="text-lg font-semibold text-white mb-4">Logs: ' + AdminAPI.esc(name) + '</h2>' +
                '<div class="space-y-3">' +
                    '<div><h3 class="text-xs font-medium text-accent-400 mb-1">Blue</h3>' +
                    '<pre class="bg-surface-950 rounded-lg p-3 text-xs text-surface-300 font-mono max-h-48 overflow-auto">' + AdminAPI.esc(logs.blue || 'No logs') + '</pre></div>' +
                    '<div><h3 class="text-xs font-medium text-accent-400 mb-1">Green</h3>' +
                    '<pre class="bg-surface-950 rounded-lg p-3 text-xs text-surface-300 font-mono max-h-48 overflow-auto">' + AdminAPI.esc(logs.green || 'No logs') + '</pre></div>' +
                '</div>' +
                '<div class="mt-4"><button onclick="AdminAPI.closeModal()" class="px-4 py-2 bg-surface-800 hover:bg-surface-700 text-surface-300 text-sm rounded-lg transition-colors">Close</button></div>' +
            '</div>';
            AdminAPI.showModal(html);
        }).catch(function(err) {
            addError('AppManager.showLogs', err.message);
            AdminAPI.toast('Failed to load logs: ' + err.message, 'error');
        });
    }
};

function initCpuHistory(name) {
    if (!CpuHistory[name]) {
        CpuHistory[name] = { blue: [], green: [] };
    }
}

function formatCpu(c) {
    if (c == null) return '-';
    return c.toFixed(1) + '%';
}

function updateCpuHistory(name, cpuData) {
    initCpuHistory(name);
    var now = Date.now();
    CpuHistory[name].blue.push({ time: now, value: cpuData.blue });
    CpuHistory[name].green.push({ time: now, value: cpuData.green });
    
    var cutoff = now - (CPU_HISTORY_SECONDS * 1000);
    CpuHistory[name].blue = CpuHistory[name].blue.filter(function(p) { return p.time > cutoff; });
    CpuHistory[name].green = CpuHistory[name].green.filter(function(p) { return p.time > cutoff; });
}

function renderCpuGraph(name, slot) {
    initCpuHistory(name);
    var history = CpuHistory[name][slot];
    if (!history || history.length < 2) {
        return '<div class="text-[8px] text-surface-600 text-center leading-tight h-full flex items-center justify-center">Collecting...</div>';
    }
    
    var width = 200;
    var height = 32;
    var padding = 2;
    
    var maxVal = Math.max(100, Math.max(...history.map(function(d) { return d.value; }), 0));
    var minTime = history[0].time;
    var maxTime = history[history.length - 1].time;
    var timeRange = maxTime - minTime || 1;
    
    var points = history.map(function(d) {
        var x = padding + ((d.time - minTime) / timeRange) * (width - 2 * padding);
        var y = height - padding - (d.value / maxVal) * (height - 2 * padding);
        return x + ',' + y;
    }).join(' ');
    
    var currentVal = history[history.length - 1].value;
    var color = slot === 'blue' ? '#60a5fa' : '#34d399';
    
    return '<div class="relative w-full h-full">' +
        '<svg width="' + width + '" height="' + height + '" class="w-full">' +
            '<defs>' +
                '<linearGradient id="grad-' + name.replace(/\W/g, '') + '-' + slot + '" x1="0%" y1="0%" x2="0%" y2="100%">' +
                    '<stop offset="0%" style="stop-color:' + color + ';stop-opacity:0.3" />' +
                    '<stop offset="100%" style="stop-color:' + color + ';stop-opacity:0" />' +
                '</linearGradient>' +
            '</defs>' +
            '<polygon points="' + padding + ',' + (height - padding) + ' ' + points + ' ' + (width - padding) + ',' + (height - padding) + '" fill="url(#grad-' + name.replace(/\W/g, '') + '-' + slot + ')" />' +
            '<polyline points="' + points + '" fill="none" stroke="' + color + '" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />' +
        '</svg>' +
    '</div>';
}

function refreshCpuData() {
    AdminAPI.getAllAppSystemMetrics().then(function(d) {
        var data = d.data || {};
        Object.keys(data).forEach(function(name) {
            var sysMetrics = data[name];
            var blueCpu = sysMetrics.blue && sysMetrics.blue.cpu_percent;
            var greenCpu = sysMetrics.green && sysMetrics.green.cpu_percent;
            updateCpuHistory(name, { blue: blueCpu || 0, green: greenCpu || 0 });
        });
        
        document.querySelectorAll('[data-cpu-graph-current]').forEach(function(el) {
            var name = el.dataset.appName;
            var currentSlot = el.dataset.currentSlot;
            el.innerHTML = renderCpuGraph(name, currentSlot);
        });

        document.querySelectorAll('[data-cpu-current-value]').forEach(function(el) {
            var name = el.dataset.appName;
            var slot = el.dataset.slot;
            var history = CpuHistory[name] && CpuHistory[name][slot];
            if (history && history.length > 0) {
                var val = history[history.length - 1].value;
                el.textContent = formatCpu(val);
            }
        });
    }).catch(function(err) { addError('refreshCpuData', err.message); AdminAPI.toast('Failed to refresh CPU data: ' + err.message, 'error'); });
}

AppManager.bindGridEvents();
AppManager.load().then(function() {
    refreshCpuData();
    connectAppEvents();
});

renderErrorHistory();
setInterval(refreshCpuData, CPU_REFRESH_INTERVAL);
</script>
