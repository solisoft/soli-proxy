                </div>
                <h3 class="text-xl font-bold text-white mb-2">WebSocket Proxy</h3>
                <p class="text-gray-400 text-sm">Transparent WebSocket proxying with bidirectional streaming. Works with livereload, real-time apps, and any WS protocol.</p>
            </div>

            <!-- Hot Reload -->
            <div class="group relative rounded-3xl bg-gray-900 border border-white/10 p-8 hover:bg-white/5 transition-all duration-300 " style="transition-delay: 300ms;">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-teal-500/10 text-teal-400 mb-6 group-hover:rotate-12 transition-transform">
