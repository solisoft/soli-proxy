<section class="relative py-16 sm:py-24">
    <div class="container mx-auto max-w-7xl px-6 lg:px-8">
        <div class="flex gap-12">

            <!-- Sidebar -->
            <aside class="hidden lg:block w-56 shrink-0">
                <nav class="doc-sidebar sticky top-24 space-y-1 text-sm">
                    <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3 px-3">Documentation</div>
                    <a href="/docs/getting-started" class="block px-3 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all">Getting Started</a>
