                                <span class="w-3 h-3 rounded-full bg-red-500/60"></span>
                                <span class="w-3 h-3 rounded-full bg-yellow-500/60"></span>
                                <span class="w-3 h-3 rounded-full bg-green-500/60"></span>
                                <span class="ml-2 text-xs text-gray-500 font-mono">terminal</span>
                            </div>
                            <pre class="p-6 text-sm leading-relaxed overflow-x-auto"><code><span class="tc">$ </span>curl -s http://127.0.0.1:9090/api/v1/routes \
  -H <span class="ts">"X-Api-Key: your-secret-api-key"</span> | jq</code></pre>
                        </div>
                    </div>

                    <!-- Add a new route -->
                    <div class="mb-6">
