                    </p>

                    <!-- Check server status -->
                    <div class="mb-6">
                        <h3 class="text-sm font-semibold text-gray-300 mb-3">Check server status</h3>
                        <div class="rounded-2xl bg-gray-900 border border-white/10 overflow-hidden">
                            <div class="flex items-center gap-2 px-4 py-3 bg-black/30 border-b border-white/5">
                                <span class="w-3 h-3 rounded-full bg-red-500/60"></span>
                                <span class="w-3 h-3 rounded-full bg-yellow-500/60"></span>
                                <span class="w-3 h-3 rounded-full bg-green-500/60"></span>
                                <span class="ml-2 text-xs text-gray-500 font-mono">terminal</span>
                            </div>
                            <pre class="p-6 text-sm leading-relaxed overflow-x-auto"><code><span class="tc">$ </span>curl -s http://127.0.0.1:9090/api/v1/status \
  -H <span class="ts">"X-Api-Key: your-secret-api-key"</span> | jq

<span class="tc">{</span>
  <span class="tf">"version"</span>: <span class="ts">"0.1.0"</span>,
