                <!-- ============================================================ -->
                <div class="mb-12 reveal-on-scroll">
                    <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                        <span class="w-7 h-7 rounded-lg bg-emerald-500/10 flex items-center justify-center text-emerald-400 text-xs font-bold">2</span>
                        Request Lifecycle
                    </h2>
                    <p class="text-gray-400 mb-6 leading-relaxed">
                        Every proxied request passes through four hook points. Each hook receives context about the request and can inspect, modify, or short-circuit the flow.
                    </p>

                    <div class="code-window rounded-xl bg-black/40 border border-white/10 overflow-hidden">
                        <div class="flex items-center justify-between px-4 py-2.5 bg-white/5 border-b border-white/5">
                            <div class="flex items-center gap-2">
                                <div class="flex gap-1.5">
                                    <div class="w-2.5 h-2.5 rounded-full bg-red-500/60"></div>
                                    <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/60"></div>
                                    <div class="w-2.5 h-2.5 rounded-full bg-green-500/60"></div>
                                </div>
                                <span class="text-xs text-gray-500">Request Lifecycle</span>
                            </div>
                        </div>
                        <pre class="p-4 sm:p-6 text-xs sm:text-sm leading-relaxed overflow-x-auto"><code class="text-gray-300"><span class="tc">  Client</span>
<span class="tc">    |</span>
<span class="tc">    v</span>
<span class="tf">Request arrives</span>
    |
    v
<span class="tk">on_request</span>(<span class="tt">req</span>)          <span class="tc">-- Auth, WAF, validation. Return req:deny() to block.</span>
    |
    v
<span class="tf">find_target</span>              <span class="tc">-- Proxy resolves backend from routing table</span>
    |
    v
<span class="tk">on_route</span>(<span class="tt">req</span>, <span class="tt">target</span>)    <span class="tc">-- Dynamic routing, A/B testing. Return URL to override.</span>
    |
    v
<span class="tf">Backend request</span>          <span class="tc">-- Soli forwards to upstream server</span>
    |
    v
<span class="tk">on_response</span>(<span class="tt">req</span>, <span class="tt">resp</span>)   <span class="tc">-- CORS, header stripping, body transform.</span>
    |
    v
<span class="tk">on_request_end</span>(<span class="tt">...</span>)      <span class="tc">-- Logging, metrics. Fire-and-forget.</span>
    |
    v
<span class="tc">  Client</span></code></pre>
                    </div>
                </div>

                <!-- ============================================================ -->
