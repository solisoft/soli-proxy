                <!-- ============================================================ -->
                <div class="mb-12 reveal-on-scroll">
                    <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                        <span class="w-7 h-7 rounded-lg bg-emerald-500/10 flex items-center justify-center text-emerald-400 text-xs font-bold">4</span>
                        Script Examples
                    </h2>
                    <p class="text-gray-400 mb-6 leading-relaxed">
                        Real-world examples showing common patterns. Place these in your <code class="text-emerald-300 text-xs bg-emerald-500/10 px-1.5 py-0.5 rounded">scripts/</code> directory.
                    </p>

                    <div class="code-window rounded-xl bg-black/40 border border-white/10 overflow-hidden">
                        <!-- Tab Bar -->
                        <div class="flex items-center gap-1 px-4 py-2.5 bg-white/5 border-b border-white/5 overflow-x-auto">
