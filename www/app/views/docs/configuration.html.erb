<span class="tf">failure_threshold</span> = <span class="tn">5</span>        <span class="tc"># Consecutive failures before opening</span>
<span class="tf">recovery_timeout_secs</span> = <span class="tn">30</span>   <span class="tc"># Seconds before probing an open backend</span>
<span class="tf">success_threshold</span> = <span class="tn">2</span>        <span class="tc"># Successful probes needed to close</span>
<span class="tf">failure_status_codes</span> = [<span class="tn">502</span>, <span class="tn">503</span>, <span class="tn">504</span>]  <span class="tc"># HTTP codes that count as failures</span></code></pre>
