                                    <tr class="border-b border-white/5"><td class="py-2 pr-4 font-mono text-cyan-300 text-xs">recovery_timeout_secs</td><td class="py-2 pr-4">integer</td><td class="py-2 pr-4 text-gray-500">30</td><td class="py-2">Seconds to wait before half-open probe</td></tr>
                                    <tr class="border-b border-white/5"><td class="py-2 pr-4 font-mono text-cyan-300 text-xs">success_threshold</td><td class="py-2 pr-4">integer</td><td class="py-2 pr-4 text-gray-500">2</td><td class="py-2">Successes needed to close breaker</td></tr>
                                    <tr class="border-b border-white/5"><td class="py-2 pr-4 font-mono text-cyan-300 text-xs">failure_status_codes</td><td class="py-2 pr-4">array</td><td class="py-2 pr-4 text-gray-500">[502, 503, 504]</td><td class="py-2">HTTP status codes treated as failures</td></tr>
