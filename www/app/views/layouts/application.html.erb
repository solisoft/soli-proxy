<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Soli Proxy</title>
    <meta name="description" content="<%= description %>">
    <link rel="canonical" href="https://proxy.solisoft.net<%= path %>">
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
    <meta name="theme-color" content="#0a0c10">

    <!-- Link previews (Slack, WhatsApp, LinkedIn, X…): absolute URLs only. -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Soli Proxy">
    <meta property="og:title" content="<%= title %> - Soli Proxy">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:url" content="https://proxy.solisoft.net<%= path %>">
    <meta property="og:image" content="https://proxy.solisoft.net/images/og.png">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Soli Proxy, HTTP/2 reverse proxy built in Rust, with its terminal UI routing traffic to blue, green, sleeping and maintenance apps">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title %> - Soli Proxy">
    <meta name="twitter:description" content="<%= description %>">
    <meta name="twitter:image" content="https://proxy.solisoft.net/images/og.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300..800&family=Geist+Mono:wght@400..600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="<%= public_path("css/application.css") %>">
    <script src="/js/main.js" defer></script>
    <!-- Loaded on every page: links swap <body> without a reload, so a script
         only the home view included would never start after a click. It does
         nothing on a page without #tui. -->
    <script src="/js/tui.js" defer></script>
</head>
<body class="bg-ink text-fg flex flex-col min-h-full antialiased">
    <nav class="sticky top-0 z-50 bg-ink border-b border-rule">
        <div class="px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-14">
                <a href="/" class="flex items-center gap-2 font-mono text-sm" aria-label="Soli Proxy, home">
                    <span class="bg-accent text-ink font-semibold px-1.5 leading-6">SOLI</span>
                    <span class="text-muted">proxy</span>
                </a>

                <div class="hidden md:flex items-center gap-6 font-mono text-[13px]">
                    <a href="/docs" class="text-soft hover:text-fg transition-colors duration-150">docs</a>
                    <a href="/docs/benchmark" class="text-soft hover:text-fg transition-colors duration-150">benchmark</a>
                    <a href="/changelog" class="text-soft hover:text-fg transition-colors duration-150">changelog</a>
                    <a href="https://github.com/solisoft/soli-proxy" target="_blank" rel="noopener" class="text-soft hover:text-fg transition-colors duration-150">github</a>
                    <a href="/docs/getting-started" class="btn btn-outline !py-1.5">install</a>
                </div>

                <div class="md:hidden flex items-center">
                    <button onclick="toggleMobileNav()" aria-label="Toggle navigation" class="p-2 -mr-2 text-soft hover:text-fg transition-colors duration-150">
                        <svg id="menuIcon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
                        <svg id="closeIcon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>
            </div>
        </div>

        <div id="mobileNav" class="mobile-nav absolute top-full left-0 right-0 z-40 bg-ink border-b border-rule">
            <div class="px-4 py-3 font-mono text-sm">
                <a href="/docs/getting-started" class="block py-2 text-fg">getting started</a>
                <a href="/docs/apps" class="block py-2 text-soft">apps</a>
                <a href="/docs/configuration" class="block py-2 text-soft">configuration</a>
                <a href="/docs/admin-api" class="block py-2 text-soft">admin api</a>
                <a href="/docs/scripting" class="block py-2 text-soft">scripting</a>
                <a href="/docs/security" class="block py-2 text-soft">security</a>
                <a href="/docs/deployment" class="block py-2 text-soft">deployment</a>
                <a href="/docs/benchmark" class="block py-2 text-soft">benchmark</a>
                <a href="/changelog" class="block py-2 text-soft">changelog</a>
                <a href="https://github.com/solisoft/soli-proxy" target="_blank" rel="noopener" class="block py-2 text-soft">github</a>
            </div>
        </div>
    </nav>

    <main class="flex-grow">
        <%= yield %>
    </main>

    <footer class="border-t border-rule mt-auto">
        <div class="px-4 sm:px-6 lg:px-8 py-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between font-mono text-[13px]">
            <div class="flex flex-wrap gap-x-5 gap-y-2">
                <a href="/docs/getting-started" class="text-soft hover:text-fg transition-colors duration-150">getting started</a>
                <a href="/docs/apps" class="text-soft hover:text-fg transition-colors duration-150">apps</a>
                <a href="/docs/configuration" class="text-soft hover:text-fg transition-colors duration-150">configuration</a>
                <a href="/docs/admin-api" class="text-soft hover:text-fg transition-colors duration-150">admin api</a>
                <a href="/docs/deployment" class="text-soft hover:text-fg transition-colors duration-150">deployment</a>
                <a href="/changelog" class="text-soft hover:text-fg transition-colors duration-150">changelog</a>
                <a href="https://github.com/solisoft/soli-proxy" target="_blank" rel="noopener" class="text-soft hover:text-fg transition-colors duration-150">github</a>
            </div>
            <p class="text-muted">&copy; 2026 SoliSoft &middot; MIT</p>
        </div>
    </footer>
</body>
</html>
